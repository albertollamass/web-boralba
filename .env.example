# Copia este archivo a `.env` y rellena los valores de tu proyecto Supabase
# "boralba-lightning".
# Los valores los encuentras en Supabase: Dashboard > Project Settings > API.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase recomienda las "publishable keys" (formato sb_publishable_...) en lugar
# de las antiguas anon keys. El proyecto acepta también VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE

# La publishable key solo permite LECTURA pública del catálogo (política RLS "select").
# Para escribir hay que iniciar sesión como admin (Supabase Auth) en /admin.
# Nunca pongas la service_role key aquí: es secreta y solo va en el servidor.
