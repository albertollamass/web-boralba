# Copia este archivo a `.env` y rellena los valores de tu proyecto Firebase
# "boralba-lighting".
# Los valores los encuentras en Firebase Console > Project settings > Your apps > Web > SDK setup.
#
# Migración desde Supabase:
# - VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY ya no se usan (puedes borrarlas).
# - Crea el proyecto en https://console.firebase.google.com/ y pega aquí los valores.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=web-boralba.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=web-boralba
VITE_FIREBASE_STORAGE_BUCKET=web-boralba.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Documentos PDF del panel /admin: se suben a Cloudinary (plan gratuito, sin tarjeta)
# porque Firestore limita cada documento a 1 MiB y Firebase Storage exige plan Blaze.
# 1. Crea cuenta en https://cloudinary.com/ (gratis).
# 2. Settings > Upload > Upload presets > Add upload preset con Signing Mode = Unsigned
#    (p. ej. nombre `boralba-docs`).
# 3. Rellena estas dos variables. Sin ellas, solo se admiten PDFs < 700 KB (inline).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=boralba-docs

# Formulario "Diseña tu luminaria": envío por email con Web3Forms (web estática).
# Crea tu access key gratis en https://web3forms.com/ y pégala aquí.
# En GitHub, súbela en Settings → Secrets and variables → Actions → Variables
# con el mismo nombre (VITE_WEB3FORMS_ACCESS_KEY).
VITE_WEB3FORMS_ACCESS_KEY=
